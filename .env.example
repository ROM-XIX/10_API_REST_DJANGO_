# Template des variables d'environnement de SoftDesk.
# Copie ce fichier vers .env et remplis les valeurs réelles.
# Génère une SECRET_KEY avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

DJANGO_SECRET_KEY="<your-secret-key-here>"
DJANGO_DEBUG=True
