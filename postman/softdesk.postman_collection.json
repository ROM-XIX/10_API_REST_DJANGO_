{
  "info": {
    "_postman_id": "softdesk-collection-2026",
    "name": "SoftDesk Support API",
    "description": "Collection complète de l'API SoftDesk (OC P10). Importer aussi l'environnement.\n\n**Ordre recommandé** :\n1. Register Alice\n2. Register Bob\n3. Login Alice → JWT auto-extrait\n4. Create Project → projectId auto-extrait\n5. Add Bob as Contributor\n6. Create Issue → issueId auto-extrait\n7. Create Comment → commentUuid auto-extrait\n8. Explorer les autres endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Alice",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"verysecret123\",\n  \"age\": 25,\n  \"can_be_contacted\": true,\n  \"can_data_be_shared\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register", ""]
            }
          }
        },
        {
          "name": "Register Bob",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"bob\",\n  \"email\": \"bob@example.com\",\n  \"password\": \"verysecret123\",\n  \"age\": 30,\n  \"can_be_contacted\": false,\n  \"can_data_be_shared\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register", ""]
            }
          }
        },
        {
          "name": "Register — Refus < 15 ans (RGPD)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"kid\",\n  \"email\": \"k@k.com\",\n  \"password\": \"verysecret123\",\n  \"age\": 14,\n  \"can_be_contacted\": false,\n  \"can_data_be_shared\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register", ""]
            },
            "description": "Doit retourner 400 avec message RGPD."
          }
        },
        {
          "name": "Login Alice (auto-extract JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const r = pm.response.json();",
                  "    pm.environment.set('accessToken', r.access);",
                  "    pm.environment.set('refreshToken', r.refresh);",
                  "    console.log('Tokens stored in environment');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"verysecret123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login", ""]
            }
          }
        },
        {
          "name": "Refresh token (auto-update access+refresh)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const r = pm.response.json();",
                  "    pm.environment.set('accessToken', r.access);",
                  "    if (r.refresh) { pm.environment.set('refreshToken', r.refresh); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/refresh/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login", "refresh", ""]
            }
          }
        },
        {
          "name": "Logout (blacklist refresh)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{accessToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout", ""]
            }
          }
        }
      ]
    },
